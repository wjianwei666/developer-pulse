# AgentPulse Environment Variables (copy to .env)
# All fields are optional — AgentPulse runs fine with defaults.

# === Webhook Notifications (P0) ===
# Slack incoming webhook URL (leave empty to disable)
SLACK_WEBHOOK_URL=
# Discord incoming webhook URL (leave empty to disable)
DISCORD_WEBHOOK_URL=

# === GitHub OAuth (P2, optional) ===
# Register a GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:7050/auth/github/callback
SESSION_SECRET=change-me-in-production

# === Pipeline Tuning ===
# OPENROUTER_URL=https://openrouter.ai/api/v1/models
# OPENROUTER_POLL_HOURS=6
# GITHUB_POLL_HOURS=2
# MCP_POLL_HOURS=24
# DIGEST_TIME_UTC=07:00

# === Scoring Thresholds ===
# SCORE_ALERT_THRESHOLD=70
# SCORE_DIGEST_THRESHOLD=40
# PRICE_NOISE_THRESHOLD_PCT=0.5

# === Blended Cost Ratios (cache:input:output) ===
# BLENDED_CACHE_RATIO=0.7
# BLENDED_INPUT_RATIO=0.2
# BLENDED_OUTPUT_RATIO=0.1

# === Server ===
# SITE_HOST=0.0.0.0
# SITE_PORT=7050